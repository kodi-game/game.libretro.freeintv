msgctxt "Addon Summary"
msgid "Mattel - Intellivision (FreeIntv)"
msgstr "Mattel - Intellivision (FreeIntv)"

msgctxt "Addon Description"
msgid "FreeIntv is a libretro emulation core for the Mattel Intellivision designed for joypad compatibility."
msgstr "FreeIntv je emulační jádro Libretro pro Mattel Intellivision navržené pro kompatibilitu s gamepady."

# Empty string with ID 30000
msgctxt "#30001"
msgid "Default Player 1 Controller (Restart)"
msgstr "Výchozí ovladač hráče 1 (vyžaduje restart)"

msgctxt "#30002"
msgid "Onscreen Interactive Keypad Overlays (Restart and Touchscreen/Mouse Required)"
msgstr "Interaktivní překryvy klávesnice na obrazovce (vyžaduje restart a dotykovou obrazovku/myš)"

msgctxt "#30003"
msgid "Input"
msgstr "Vstup"

msgctxt "#30004"
msgid "Change controller settings."
msgstr "Změnit nastavení ovladače."

msgctxt "#30005"
msgid "Specify whether the Left or Right Controller is set to Player 1 as the default."
msgstr "Určuje, zda je jako výchozí pro hráče 1 nastaven levý, nebo pravý ovladač."

msgctxt "#30006"
msgid "Left"
msgstr "Levý"

msgctxt "#30007"
msgid "Right"
msgstr "Pravý"

msgctxt "#30008"
msgid "Display"
msgstr "Zobrazení"

msgctxt "#30009"
msgid "Change display settings."
msgstr "Změnit nastavení zobrazení."

msgctxt "#30010"
msgid "Enable multi-screen mode with onscreen interactive keypad overlays (370x600 PNG files) and side-by-side game/keypad display. Changing this setting requires a core restart. Mouse or touchscreen input is required to interact with the keypad overlays."
msgstr "Povoluje režim s více obrazovkami, který používá interaktivní překryvy klávesnice na obrazovce (soubory PNG o rozměrech 370x600) a zobrazuje hru a klávesnici vedle sebe. Změna tohoto nastavení vyžaduje restart jádra. K ovládání překryvů klávesnice je nutná myš nebo dotyková obrazovka."

msgctxt "#30011"
msgid "Disabled"
msgstr "Zakázáno"

msgctxt "#30012"
msgid "Enabled"
msgstr "Povoleno"
